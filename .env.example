# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=http://127.0.0.1:4173

# AI generation now runs through a Supabase Edge Function.
# Set OPENAI_API_KEY in Supabase secrets instead of exposing it to the client.

# Billing Configuration
# Frontend never needs Binance Pay secret keys.
# Add these values as Supabase Edge Function secrets:
# APP_BASE_URL=http://127.0.0.1:4173
# BINANCE_PAY_API_KEY=api_identity_key
# BINANCE_PAY_SECRET_KEY=secret_key
# BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# BINANCE_PAY_CURRENCY=USDT
# BINANCE_PAY_ORDER_EXPIRE_MINUTES=20
# BINANCE_PAY_PRO_MONTHLY_AMOUNT=29
# BINANCE_PAY_PRO_THREE_MONTH_AMOUNT=79
